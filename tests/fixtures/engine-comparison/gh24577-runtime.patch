diff --git a/Zend/zend_atomic.h b/Zend/zend_atomic.h
index 5eeb212ec09e..677d2ed0ccb2 100644
--- a/Zend/zend_atomic.h
+++ b/Zend/zend_atomic.h
@@ -402,6 +402,19 @@ ZEND_API int zend_atomic_int_load(const zend_atomic_int *obj);
 # define ZEND_ATOMIC_FENCE_ACQUIRE() ((void)0)
 #endif
 
+static zend_always_inline uint32_t zend_atomic_load_acquire_32(const uint32_t *ptr)
+{
+#if defined(__GNUC__) || defined(__clang__) || defined(HAVE_GNUC_ATOMICS)
+	return __atomic_load_n(ptr, __ATOMIC_ACQUIRE);
+#else
+	uint32_t val = *(const volatile uint32_t *)ptr;
+	ZEND_ATOMIC_FENCE_ACQUIRE();
+	return val;
+#endif
+}
+
+#define ZEND_ATOMIC_LOAD_ACQUIRE_32(ptr) zend_atomic_load_acquire_32(ptr)
+
 END_EXTERN_C()
 
 #endif
diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index b2e40e2a2c88..5d4f87490731 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -24,6 +24,7 @@
 
 #include "zend_portability.h"
 #include "zend_long.h"
+#include "zend_atomic.h"
 #include <stdbool.h>
 #include <stdint.h>
 
@@ -862,7 +863,13 @@ static zend_always_inline uint32_t zval_gc_info(uint32_t gc_type_info) {
 #define OBJ_EXTRA_FLAGS(obj)		((obj)->extra_flags)
 
 /* Fast class cache */
-#define ZSTR_HAS_CE_CACHE(s)		(GC_FLAGS(s) & IS_STR_CLASS_NAME_MAP_PTR)
+static zend_always_inline bool zstr_has_ce_cache(const zend_string *s)
+{
+	uint32_t type_info = ZEND_ATOMIC_LOAD_ACQUIRE_32(&GC_TYPE_INFO(s));
+	return (type_info & (IS_STR_CLASS_NAME_MAP_PTR << GC_FLAGS_SHIFT)) != 0;
+}
+
+#define ZSTR_HAS_CE_CACHE(s)		zstr_has_ce_cache(s)
 #define ZSTR_GET_CE_CACHE(s)		ZSTR_GET_CE_CACHE_EX(s, 1)
 #define ZSTR_SET_CE_CACHE(s, ce)	ZSTR_SET_CE_CACHE_EX(s, ce, 1)
 
